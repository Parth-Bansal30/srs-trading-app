{
  "name": "srs-trading-app",
  "private": true,
  "description": "SRS Trading App \u2014 steel trading orders, cutting, weighing, GST/kacha billing and khata.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "cd packages/core && TZ=Asia/Kolkata node --test \"test/**/*.test.js\"",
    "test:utc": "cd packages/core && TZ=UTC node --test \"test/**/*.test.js\"",
    "db:status": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-migrate.mjs --status",
    "db:migrate": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-migrate.mjs",
    "db:test": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-test.mjs",
    "db:replay-check": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-replay-check.mjs",
    "auth:e2e": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/auth-e2e.mjs",
    "functions:deploy": "sh -c 'export SUPABASE_ACCESS_TOKEN=$(sed -n \"s/^SUPABASE_ACCESS_TOKEN=//p\" .env); npx --yes supabase@2 functions deploy --project-ref xwyhgsukvspwinsskyjo --use-api'"
  }
}

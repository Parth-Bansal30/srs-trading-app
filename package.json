{
  "name": "srs-trading-app",
  "private": true,
  "description": "SRS Trading App \u2014 steel trading orders, cutting, weighing, GST/kacha billing and khata.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "cd packages/core && TZ=Asia/Kolkata node --test \"test/**/*.test.js\"",
    "test:utc": "cd packages/core && TZ=UTC node --test \"test/**/*.test.js\"",
    "db:status": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-migrate.mjs --status",
    "db:migrate": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-migrate.mjs",
    "db:test": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-test.mjs",
    "db:replay-check": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-replay-check.mjs",
    "auth:config": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/auth-config.mjs",
    "auth:e2e": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/auth-e2e.mjs",
    "functions:deploy": "node scripts/sync-core.mjs && sh -c 'export SUPABASE_ACCESS_TOKEN=$(sed -n \"s/^SUPABASE_ACCESS_TOKEN=//p\" .env); $HOME/tools/sb/node_modules/.bin/supabase functions deploy --project-ref xwyhgsukvspwinsskyjo --use-api --workdir .'",
    "test:api": "node --test supabase/functions/api/ops.test.mjs supabase/functions/api/webpush.test.mjs",
    "test:web": "node --test apps/web/test/overlay.test.mjs",
    "core:sync": "node scripts/sync-core.mjs",
    "domain:e2e": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/domain-e2e.mjs",
    "db:parity-check": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-parity-check.mjs",
    "seed:dev": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/seed-dev.mjs",
    "web:dev": "cd apps/web && npx vite",
    "web:build": "cd apps/web && npx vite build --mode development",
    "web:single": "cd apps/web && npx vite build --mode single",
    "evening:setup": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/evening-setup.mjs",
    "money:e2e": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/money-e2e.mjs",
    "db:try": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/db-try.mjs"
  }
}
